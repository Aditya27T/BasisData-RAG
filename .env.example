# =============================================================================
# .env.example — salin ke .env dan isi nilainya
# Semua variabel dipakai oleh package hybrid-rag (via config.py)
# dan oleh aplikasi cobarag (app/).
# =============================================================================

# -----------------------------------------------------------------------------
# LLM — wajib diisi sebelum M1
# Provider harus kompatibel OpenAI (base_url + api_key + model_id).
# Belum diputuskan; pilihan: OpenRouter, Groq, Together, dll.
# -----------------------------------------------------------------------------
LLM_BINDING_HOST=https://openrouter.ai/api/v1
LLM_BINDING_API_KEY=sk-or-...
LLM_MODEL=meta-llama/llama-3.1-8b-instruct

# LLM untuk ekstraksi keyword (opsional; fallback ke LLM_* jika kosong)
# KEYWORD_LLM_MODEL=
# KEYWORD_LLM_BINDING_HOST=
# KEYWORD_LLM_BINDING_API_KEY=

# Knowledge graph extraction uses Gemini and the VLM API key when this model
# matches VLM_MODEL. Parsed document text is sent to Google for graph extraction.
EXTRACT_LLM_MODEL=gemini-3.5-flash-lite
EXTRACT_LLM_TIMEOUT=300
# EXTRACT_LLM_BINDING_HOST=   # only for OpenAI-compatible extraction providers
# EXTRACT_LLM_BINDING_API_KEY= # only for OpenAI-compatible extraction providers

# Batas konkurensi LLM
LLM_MAX_ASYNC=4
MAX_RETRIES=5

# -----------------------------------------------------------------------------
# Embedding lokal via Ollama
# Model terkunci: bge-m3 (1024 dimensi, multibahasa, mendukung Indonesia).
# Siapkan runtime dengan `ollama pull bge-m3`; API key wajib diisi oleh client,
# tetapi diabaikan oleh server Ollama lokal.
# Tidak ada fallback otomatis ke provider API agar ruang vektor tidak tercampur.
# -----------------------------------------------------------------------------
EMBEDDING_BINDING_HOST=http://localhost:11434/v1
EMBEDDING_BINDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_BATCH_NUM=1
EMBEDDING_FUNC_MAX_ASYNC=1
EMBEDDING_TIMEOUT=60.0

# -----------------------------------------------------------------------------
# LlamaParse — untuk ingest PDF dan Office (M2)
# Tier gratis punya kuota kredit bulanan; cek https://cloud.llamaindex.ai/
# Tidak dibutuhkan untuk M0 dan M1 (hanya .md)
# -----------------------------------------------------------------------------
# Parse API v2 wajib menyebut tier + version
LLAMA_PARSE_TIER=cost_effective
LLAMA_PARSE_VERSION=latest
LLAMA_CLOUD_API_KEY=llx-...

# -----------------------------------------------------------------------------
# PostgreSQL / ParadeDB
# Nilai default cocok dengan docker-compose.yml
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SCHEMA=rag
POSTGRES_MAX_CONNECTIONS=10
POSTGRES_SSL_MODE=disable

# Bootstrap tabel + index otomatis saat pertama kali jalan (idempoten)
RAG_SCHEMA_BOOTSTRAP=true

# Tipe index vektor (HNSW direkomendasikan)
POSTGRES_VECTOR_INDEX_TYPE=HNSW
POSTGRES_HNSW_M=16
POSTGRES_HNSW_EF=256

# -----------------------------------------------------------------------------
# Neo4j aktif untuk ekstraksi dan retrieval knowledge graph.
# Jalankan lokal dengan: docker compose --profile graph up -d neo4j
# Untuk Neo4j Aura, ganti URI, username, password, dan database di bawah.
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=10

# -----------------------------------------------------------------------------
# Reranking — KOSONGKAN untuk mematikan (v1)
# -----------------------------------------------------------------------------
# Optional local multilingual reranker; downloads about 1.1 GB on first use.
# License: CC-BY-NC-4.0 (non-commercial use only).
# RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
RERANK_TIMEOUT=180
RERANK_BY_DEFAULT=false
LANGGRAPH_MAX_RETRIES=1
# RETRIEVAL_MIN_SCORE=            # opsional; no-op sampai engine mengekspos skor chunk

# -----------------------------------------------------------------------------
# Contextualize — KOSONGKAN untuk mematikan (v1, mahal)
# -----------------------------------------------------------------------------
# PRD v1: contextualize per child dimatikan (hemat LLM, lebih tahan error)
ENABLE_CONTEXTUALIZE=false
# CONTEXTUALIZE_MODEL=

# -----------------------------------------------------------------------------
# Chunking — ukuran default sesuai PRD
# -----------------------------------------------------------------------------
PARENT_CHUNK_SIZE=2500
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=310
CHILD_CHUNK_OVERLAP=50

# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------
TOP_K=40
CHUNK_TOP_K=20
PARENT_TOP_K=10
COSINE_THRESHOLD=0.2
HYBRID_SEARCH_CHUNK_CANDIDATES=30
HYBRID_SEARCH_W_SEMANTIC=1.2
HYBRID_SEARCH_W_KEYWORD=0.8

# -----------------------------------------------------------------------------
# Knowledge Graph extraction
# -----------------------------------------------------------------------------
MAX_ENTITY_TOKENS=6000
MAX_RELATION_TOKENS=8000
MAX_GRAPH_NODES=1000
MAX_EXTRACTION_ENTITIES=40
MAX_GLEANING=1

# -----------------------------------------------------------------------------
# Pipeline
# -----------------------------------------------------------------------------
MAX_PARALLEL_INGESTION=1
ENABLE_LLM_CACHE=true
MAX_WORKSPACES=10

# -----------------------------------------------------------------------------
# Workspace default (nama workspace yang dipakai oleh CLI)
# -----------------------------------------------------------------------------
WORKSPACE=docs

# -----------------------------------------------------------------------------
# VLM Google GenAI Interactions untuk captioning gambar/tabel/persamaan.
# API key khusus VLM, terpisah dari binding LLM chat.
# -----------------------------------------------------------------------------
VLM_MODEL=gemini-3.5-flash-lite
# VLM_BINDING_API_KEY=
VLM_MAX_ASYNC=1
VLM_TIMEOUT=300
# VLM_BINDING_HOST=  # dipakai hanya untuk VLM OpenAI-compatible, bukan Google SDK
